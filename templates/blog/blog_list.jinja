{% extends 'base.jinja' %}
{% block content %}
<section class="py-20 bg-gray-50 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-brand-100 text-brand-700 text-xs font-bold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider">📝 Blog</div>
      <h1 class="font-display text-4xl font-black text-gray-900 mb-3">Puja Guidance & Spiritual Insights</h1>
      <p class="text-gray-500 max-w-xl mx-auto">Tips, guides, and spiritual knowledge from our expert pandits</p>
    </div>

    {% if posts %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for post in posts %}
      <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-200 flex flex-col">
        {% if post.image %}
        <img src="{{ post.image.url }}" class="h-48 w-full object-cover"/>
        {% else %}
        <div class="h-48 bg-gradient-to-br from-brand-600 to-brand-900 flex items-center justify-center text-6xl">🕉️</div>
        {% endif %}
        <div class="p-6 flex flex-col flex-grow">
          <div class="text-xs text-gray-400 font-medium mb-3">{{ post.published_at.strftime('%d %b %Y') if post.published_at else '' }} · {{ post.author }}</div>
          <h2 class="font-display font-bold text-gray-900 text-xl mb-2 line-clamp-2">{{ post.title }}</h2>
          <p class="text-gray-500 text-sm leading-relaxed flex-grow line-clamp-3">{{ post.excerpt or post.content[:150] }}</p>
          <a href="{{ url('blog:detail', slug=post.slug) }}" class="mt-5 inline-flex items-center gap-1 text-brand-600 font-bold text-sm hover:underline">
            Read More →
          </a>
        </div>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <div class="text-center py-24">
      <div class="text-6xl mb-4">📝</div>
      <h3 class="font-display text-xl font-bold text-gray-900 mb-2">No Blog Posts Yet</h3>
      <p class="text-gray-500">Check back soon for puja guidance and spiritual insights.</p>
    </div>
    {% endif %}
  </div>
</section>
{% endblock %}
