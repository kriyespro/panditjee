{% extends 'base.jinja' %}
{% block content %}
<div class="bg-gray-50 min-h-screen py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <a href="{{ url('blog:list') }}" class="text-sm text-gray-500 hover:text-brand-600">← Back to Blog</a>
    </div>
    {% if post.image %}
    <img src="{{ post.image.url }}" class="w-full h-64 object-cover rounded-2xl shadow mb-8"/>
    {% else %}
    <div class="w-full h-48 bg-gradient-to-br from-brand-600 to-brand-900 rounded-2xl mb-8 flex items-center justify-center text-8xl shadow">🕉️</div>
    {% endif %}
    <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100">
      <div class="text-xs text-gray-400 font-medium mb-4">{{ post.published_at.strftime('%d %B %Y') if post.published_at else '' }} · {{ post.author }}</div>
      <h1 class="font-display text-3xl md:text-4xl font-black text-gray-900 mb-6">{{ post.title }}</h1>
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed whitespace-pre-wrap">{{ post.content }}</div>
    </div>

    {% if recent %}
    <div class="mt-12">
      <h3 class="font-display text-2xl font-bold text-gray-900 mb-6">More Articles</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {% for p in recent %}
        <a href="{{ url('blog:detail', slug=p.slug) }}" class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:shadow-md hover:-translate-y-0.5 transition-all block">
          <p class="text-xs text-gray-400 mb-1">{{ p.published_at.strftime('%d %b %Y') if p.published_at else '' }}</p>
          <h4 class="font-bold text-gray-900 text-sm leading-tight">{{ p.title }}</h4>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
