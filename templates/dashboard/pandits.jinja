{% extends 'base.jinja' %}

{% block content %}
<div class="flex min-h-screen bg-gray-50">
  
  <aside class="w-64 bg-slate-900 text-slate-300 flex-shrink-0 hidden md:flex flex-col">
    <div class="h-16 flex items-center px-6 bg-slate-950 text-white font-display font-bold text-xl">SD Admin Panel</div>
    <div class="p-4 flex-1 space-y-2">
      <a href="{{ url('dashboard:home') }}" class="block px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Dashboard</a>
      <a href="{{ url('dashboard:pandits') }}" class="block px-4 py-2.5 rounded-lg bg-brand-600 text-white font-medium">Pandits</a>
      <a href="{{ url('dashboard:bookings') }}" class="block px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors">Bookings</a>
      <a href="/sd/" class="block px-4 py-2.5 rounded-lg hover:bg-slate-800 hover:text-white transition-colors" target="_blank">Django Admin ↗</a>
    </div>
  </aside>

  <main class="flex-1 p-8">
    <div class="mb-6 flex items-center justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-3xl font-display font-bold text-slate-900">Manage Pandits</h1>
        <p class="text-slate-500 mt-1">View, approve, suspend and manage pandit accounts.</p>
      </div>
      <div class="flex gap-2">
        {% for val, label in status_choices %}
        <a href="?status={{ val }}" class="text-xs px-3 py-1.5 rounded-full border font-semibold transition-colors
          {{ 'bg-brand-600 text-white border-brand-600' if status_filter == val else 'border-slate-200 text-slate-600 hover:bg-slate-50' }}">{{ label }}</a>
        {% endfor %}
        <a href="?" class="text-xs px-3 py-1.5 rounded-full border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold">All</a>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200">
              <th class="p-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Pandit</th>
              <th class="p-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">City</th>
              <th class="p-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
              <th class="p-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Base Price</th>
              <th class="p-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for pandit in pandits %}
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4">
                <div class="font-bold text-slate-900">{{ pandit.user.get_full_name() }}</div>
                <div class="text-xs text-slate-500">{{ pandit.user.email }}</div>
                <div class="text-xs text-slate-500">{{ pandit.user.phone }}</div>
              </td>
              <td class="p-4 text-sm text-slate-700">{{ pandit.city.name if pandit.city else '-' }}</td>
              <td class="p-4">
                <span class="text-[10px] font-bold px-2 py-1 rounded uppercase
                  {% if pandit.status == 'APPROVED' %}bg-emerald-100 text-emerald-800
                  {% elif pandit.status == 'PENDING' %}bg-amber-100 text-amber-800
                  {% elif pandit.status == 'REJECTED' %}bg-red-100 text-red-800
                  {% else %}bg-slate-200 text-slate-600{% endif %}">
                  {{ pandit.status }}
                </span>
              </td>
              <td class="p-4 font-bold text-slate-900">₹{{ pandit.base_price }}</td>
              <td class="p-4 text-right">
                <div class="flex flex-col gap-2 items-end">
                  {% if pandit.status == 'PENDING' or pandit.status == 'REJECTED' %}
                  <form action="{{ url('dashboard:action_pandit', user_id=pandit.user.id) }}" method="POST" class="inline">
                    {{ csrf_input }}<input type="hidden" name="action" value="approve">
                    <button class="bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 text-xs px-2 py-1 rounded w-full">Approve</button>
                  </form>
                  {% endif %}
                  {% if pandit.status == 'APPROVED' %}
                  <form action="{{ url('dashboard:action_pandit', user_id=pandit.user.id) }}" method="POST" class="inline" onsubmit="return confirm('Suspend this pandit?');">
                    {{ csrf_input }}<input type="hidden" name="action" value="suspend">
                    <button class="bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 text-xs px-2 py-1 rounded w-full">Suspend</button>
                  </form>
                  {% elif pandit.status == 'SUSPENDED' %}
                  <form action="{{ url('dashboard:action_pandit', user_id=pandit.user.id) }}" method="POST" class="inline">
                    {{ csrf_input }}<input type="hidden" name="action" value="reinstate">
                    <button class="bg-sky-50 text-sky-700 border border-sky-200 hover:bg-sky-100 text-xs px-2 py-1 rounded w-full">Reinstate</button>
                  </form>
                  {% endif %}
                  <!-- Set Commission -->
                  <form action="{{ url('dashboard:action_pandit', user_id=pandit.user.id) }}" method="POST" class="flex gap-1 items-center">
                    {{ csrf_input }}<input type="hidden" name="action" value="approve">
                    <input type="number" name="commission_percent" placeholder="Commission %" min="0" max="100" step="0.5"
                      value="{{ pandit.commission_percent or '' }}"
                      class="text-xs border border-slate-200 rounded px-2 py-1 w-24 focus:outline-none focus:ring-1 focus:ring-brand-400">
                    <button class="bg-slate-50 text-slate-600 border border-slate-200 hover:bg-slate-100 text-xs px-2 py-1 rounded">Set %</button>
                  </form>
                  <a href="{{ url('core:pandit_detail', slug=pandit.slug) }}" target="_blank" class="bg-slate-50 text-slate-600 border border-slate-200 hover:bg-slate-100 text-xs px-2 py-1 rounded text-center w-full">View</a>
                </div>
              </td>
            </tr>
            {% else %}
            <tr>
              <td colspan="5" class="p-8 text-center text-slate-500">No pandits found.</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
{% endblock %}
