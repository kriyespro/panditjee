{% extends 'base.jinja' %}

{% block content %}

<!-- ═══════════════════════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════════════════════ -->
<section class="relative min-h-[92vh] flex items-center overflow-hidden">
  <!-- Layered background -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#1a0a00] via-[#3d1400] to-[#6b2800]"></div>
  <!-- Sacred pattern overlay -->
  <div class="absolute inset-0 opacity-10" style="background-image:url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23f97316%22 fill-opacity=%220.4%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>
  <!-- Glow orbs -->
  <div class="absolute top-20 right-10 w-96 h-96 bg-orange-500 opacity-10 rounded-full blur-3xl animate-pulse"></div>
  <div class="absolute bottom-10 left-10 w-72 h-72 bg-yellow-400 opacity-8 rounded-full blur-3xl"></div>
  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-28 bg-gradient-to-t from-gray-50 to-transparent"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 grid lg:grid-cols-2 gap-12 items-center w-full">

    <!-- Left: text -->
    <div>
      <!-- Badge -->
      <div class="inline-flex items-center gap-2.5 bg-white/10 backdrop-blur border border-white/20 rounded-full px-4 py-1.5 mb-8 text-sm text-white font-medium">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
        </span>
        Trusted by 5,000+ families across Gujarat
      </div>

      <!-- Headline -->
      <h1 class="font-display text-5xl md:text-6xl xl:text-7xl font-black text-white leading-[1.05] mb-6">
        Book the<br/>
        <span class="relative inline-block">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-yellow-400 to-orange-300">Perfect Pandit</span>
        </span><br/>
        for Every Puja
      </h1>

      <p class="text-white/65 text-lg md:text-xl leading-relaxed mb-10 max-w-lg">
        Verified, experienced pandits for all sacred ceremonies — at your doorstep in Surat, Ahmedabad & Vadodara.
      </p>

      <!-- Search widget -->
      <div class="bg-white rounded-2xl p-2 shadow-2xl max-w-lg">
        <form action="{{ url('core:pandit_list') }}" method="GET" class="flex flex-col sm:flex-row gap-2">
          <div class="flex-1 flex items-center gap-2 px-3 border-b sm:border-b-0 sm:border-r border-gray-100">
            <span class="text-gray-400 text-base shrink-0">📍</span>
            <select name="city" class="flex-1 py-3 text-sm text-gray-700 bg-transparent border-none outline-none font-medium">
              <option value="">Select City</option>
              {% for city in cities %}
              <option value="{{ city.slug }}">{{ city.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="flex-1 flex items-center gap-2 px-3">
            <span class="text-gray-400 text-base shrink-0">🕉️</span>
            <select name="puja" class="flex-1 py-3 text-sm text-gray-700 bg-transparent border-none outline-none font-medium">
              <option value="">Select Puja Type</option>
              {% for cat in categories %}
              <option value="{{ cat.slug }}">{{ cat.name }}</option>
              {% endfor %}
            </select>
          </div>
          <button type="submit" class="bg-gradient-to-r from-orange-500 to-brand-600 text-white font-bold px-6 py-3 rounded-xl text-sm hover:from-orange-600 hover:to-brand-700 transition-all shadow-lg whitespace-nowrap">
            Find Pandit →
          </button>
        </form>
      </div>

      <!-- Quick chips -->
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="text-white/40 text-xs self-center font-medium uppercase tracking-wider">Popular:</span>
        {% for cat in categories[:5] %}
        <a href="{{ url('core:pandit_list') }}?puja={{ cat.slug }}"
           class="text-xs font-medium bg-white/10 hover:bg-white/20 text-white/90 border border-white/15 px-3 py-1.5 rounded-full transition-all backdrop-blur-sm hover:scale-105">
          {{ cat.icon }} {{ cat.name }}
        </a>
        {% endfor %}
      </div>
    </div>

    <!-- Right: floating cards decoration -->
    <div class="hidden lg:flex flex-col gap-4 items-end">
      <!-- Big card -->
      <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-5 w-72 shadow-xl">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-2xl shadow-lg">🙏</div>
          <div>
            <p class="font-bold text-white text-sm">Pt. Ram Shastri</p>
            <p class="text-white/50 text-xs">Surat, Gujarat</p>
          </div>
          <div class="ml-auto bg-green-400/20 text-green-300 text-xs font-bold px-2 py-0.5 rounded-full">VERIFIED</div>
        </div>
        <div class="flex items-center gap-1 mb-2">{% for i in range(5) %}<span class="text-yellow-400 text-xs">★</span>{% endfor %}<span class="text-white/50 text-xs ml-1">5.0</span></div>
        <div class="flex flex-wrap gap-1">
          <span class="bg-white/10 text-white/70 text-[10px] px-2 py-0.5 rounded-full">🔥 Havan</span>
          <span class="bg-white/10 text-white/70 text-[10px] px-2 py-0.5 rounded-full">💍 Marriage</span>
          <span class="bg-white/10 text-white/70 text-[10px] px-2 py-0.5 rounded-full">🏠 Griha Pravesh</span>
        </div>
        <div class="mt-3 flex items-center justify-between">
          <span class="text-orange-300 font-bold text-sm">₹2,100</span>
          <span class="text-white/40 text-xs">Starting price</span>
        </div>
      </div>

      <!-- Stat card -->
      <div class="bg-gradient-to-br from-orange-500 to-orange-700 rounded-2xl p-4 w-56 shadow-xl">
        <p class="text-white/70 text-xs font-medium mb-1">Booking Confirmed 🎉</p>
        <p class="text-white font-bold text-sm">Satyanarayan Puja</p>
        <p class="text-orange-200 text-xs mt-1">Today, 10:30 AM · Surat</p>
        <div class="mt-3 h-1.5 bg-white/20 rounded-full overflow-hidden">
          <div class="h-full bg-white rounded-full w-3/4"></div>
        </div>
      </div>

      <!-- Mini floating badge -->
      <div class="bg-white rounded-xl p-3 shadow-xl flex items-center gap-2 w-48 animate-bounce" style="animation-duration:3s">
        <span class="text-2xl">⭐</span>
        <div>
          <p class="font-bold text-gray-900 text-xs">4.9 / 5 Stars</p>
          <p class="text-gray-400 text-[10px]">Avg platform rating</p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     STATS BAR
═══════════════════════════════════════════════════════════════ -->
<section class="relative -mt-10 z-20 max-w-5xl mx-auto px-4">
  <div class="bg-white rounded-2xl shadow-xl border border-gray-100 grid grid-cols-2 md:grid-cols-4">
    {% for num, label, icon in [('51+','Verified Pandits','🕉️'),('5,000+','Happy Families','❤️'),('5','Cities Served','📍'),('4.9 ★','Avg Rating','⭐')] %}
    <div class="flex flex-col items-center py-7 px-4 text-center border-r border-b md:border-b-0 border-gray-100 last:border-r-0">
      <span class="text-3xl mb-1.5">{{ icon }}</span>
      <span class="text-2xl font-black text-gray-900 font-display">{{ num }}</span>
      <span class="text-xs text-gray-400 mt-0.5 font-medium">{{ label }}</span>
    </div>
    {% endfor %}
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     PUJA CATEGORIES
═══════════════════════════════════════════════════════════════ -->
<section class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-orange-100 text-orange-700 text-xs font-bold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider">✦ All Ceremonies</div>
      <h2 class="font-display text-4xl font-black text-gray-900 mb-3">Puja Categories</h2>
      <p class="text-gray-500 max-w-xl mx-auto">From everyday pujas to grand ceremonies — we have a verified pandit for every occasion</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {% for cat in categories %}
      <a href="{{ url('core:pandit_list') }}?puja={{ cat.slug }}"
         class="group bg-white rounded-2xl p-5 flex flex-col items-center text-center shadow-sm border border-gray-100 hover:shadow-lg hover:border-orange-200 hover:-translate-y-1 transition-all duration-200">
        <div class="w-14 h-14 bg-orange-50 group-hover:bg-gradient-to-br group-hover:from-orange-500 group-hover:to-brand-700 rounded-2xl flex items-center justify-center text-3xl mb-3 transition-all duration-200 shadow-sm group-hover:shadow-md group-hover:scale-110">
          {{ cat.icon }}
        </div>
        <h3 class="text-sm font-bold text-gray-800 group-hover:text-orange-600 transition-colors leading-tight">{{ cat.name }}</h3>
        <span class="text-xs text-gray-400 mt-1 opacity-0 group-hover:opacity-100 transition-opacity">Book Now →</span>
      </a>
      {% endfor %}
    </div>

    <div class="text-center mt-10">
      <a href="{{ url('core:pandit_list') }}" class="inline-flex items-center gap-2 border-2 border-brand-600 text-brand-600 font-bold px-8 py-3 rounded-xl hover:bg-brand-600 hover:text-white transition-all duration-200">
        View All Pandits →
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     FEATURED PANDITS
═══════════════════════════════════════════════════════════════ -->
{% if featured_pandits %}
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-14">
      <div>
        <div class="inline-flex items-center gap-2 bg-yellow-100 text-yellow-700 text-xs font-bold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider">⭐ Top Rated</div>
        <h2 class="font-display text-4xl font-black text-gray-900">Featured Pandits</h2>
        <p class="text-gray-500 mt-2">Highest-rated verified pandits on our platform</p>
      </div>
      <a href="{{ url('core:pandit_list') }}" class="hidden md:inline-flex items-center gap-2 text-brand-600 font-bold hover:underline text-sm">
        View All 51 Pandits →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for pandit in featured_pandits %}
      <article class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-200 overflow-hidden">
        <!-- Top accent -->
        <div class="h-1.5 bg-gradient-to-r from-orange-400 via-yellow-400 to-orange-500"></div>

        <div class="p-6">
          <!-- Header -->
          <div class="flex items-start gap-3 mb-4">
            {% if pandit.user.profile_image %}
            <img src="{{ pandit.user.profile_image.url }}" class="w-14 h-14 rounded-xl object-cover ring-2 ring-orange-100 shrink-0"/>
            {% else %}
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-orange-400 to-brand-700 flex items-center justify-center text-2xl shadow-md shrink-0">🙏</div>
            {% endif %}
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-gray-900 text-base leading-tight truncate">Pt. {{ pandit.user.get_full_name() }}</h3>
              <p class="text-xs text-gray-500 mt-0.5">📍 {{ pandit.city.name if pandit.city else '' }}</p>
              <!-- Stars -->
              <div class="flex items-center gap-1 mt-1.5">
                <div class="flex">
                  {% for i in range(5) %}
                  <svg class="w-3 h-3 {{ 'text-yellow-400' if i < pandit.average_rating|int else 'text-gray-200' }}" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  {% endfor %}
                </div>
                <span class="text-xs font-semibold text-gray-600">{{ pandit.average_rating }}</span>
                <span class="text-xs text-gray-400">({{ pandit.total_bookings }})</span>
              </div>
            </div>
            <div class="shrink-0 bg-green-50 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-green-200">✓ VERIFIED</div>
          </div>

          <!-- Chips -->
          <div class="flex flex-wrap gap-1.5 mb-4">
            <span class="inline-flex items-center gap-1 text-xs bg-gray-50 border border-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-medium">⏳ {{ pandit.experience_years }}+ yrs</span>
            <span class="inline-flex items-center gap-1 text-xs bg-gray-50 border border-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-medium">🗣️ {{ pandit.languages.split(',')[0] }}</span>
            {% for spec in pandit.specializations.all()[:2] %}
            <span class="inline-flex items-center gap-1 text-xs bg-orange-50 border border-orange-100 text-orange-700 px-2.5 py-1 rounded-full font-medium">{{ spec.icon }} {{ spec.name }}</span>
            {% endfor %}
          </div>

          <!-- Price + CTA -->
          <div class="flex items-center justify-between pt-4 border-t border-gray-50">
            <div>
              <p class="text-xs text-gray-400">Starting from</p>
              <p class="text-2xl font-black text-brand-600 font-display">₹{{ pandit.base_price }}</p>
            </div>
            <a href="{{ url('core:pandit_detail', slug=pandit.slug) }}"
               class="bg-gradient-to-r from-orange-500 to-brand-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm hover:from-orange-600 hover:to-brand-700 transition-all shadow-md hover:shadow-lg">
              Book Now
            </a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>

    <div class="text-center mt-10 md:hidden">
      <a href="{{ url('core:pandit_list') }}" class="btn-primary">View All Pandits →</a>
    </div>
  </div>
</section>
{% endif %}

<!-- ═══════════════════════════════════════════════════════════════
     HOW IT WORKS
═══════════════════════════════════════════════════════════════ -->
<section class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-700 text-xs font-bold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider">✦ Simple Process</div>
      <h2 class="font-display text-4xl font-black text-gray-900 mb-3">Book in 3 Easy Steps</h2>
      <p class="text-gray-500 max-w-lg mx-auto">No calls, no hassle. Book a verified pandit online in minutes.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- connector -->
      <div class="hidden md:block absolute top-14 left-1/3 right-1/3 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"></div>

      {% for num, emoji, title, desc, color in [
        ('01','🔍','Search & Filter','Choose your city and puja type. Filter by price and language.','from-blue-500 to-blue-700'),
        ('02','🙏','Choose Pandit','Browse verified profiles, read reviews, compare prices.','from-orange-500 to-brand-700'),
        ('03','✅','Book & Confirm','Pick a date & time — get instant booking confirmation + email.','from-green-500 to-green-700'),
      ] %}
      <div class="bg-white rounded-2xl p-8 relative text-center shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-9 h-9 rounded-full bg-gradient-to-br {{ color }} text-white text-xs font-black flex items-center justify-center shadow-lg border-2 border-white">{{ num }}</div>
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br {{ color }} flex items-center justify-center text-3xl mx-auto mb-5 mt-3 shadow-lg">{{ emoji }}</div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">{{ title }}</h3>
        <p class="text-gray-500 text-sm leading-relaxed">{{ desc }}</p>
      </div>
      {% endfor %}
    </div>

    <div class="text-center mt-12">
      <a href="{{ url('core:pandit_list') }}" class="inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-brand-600 text-white font-bold px-8 py-4 rounded-xl text-base hover:from-orange-600 hover:to-brand-700 transition-all shadow-lg hover:shadow-xl">
        🙏 Find a Pandit Now →
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     CITIES
═══════════════════════════════════════════════════════════════ -->
<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-green-100 text-green-700 text-xs font-bold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider">✦ Service Areas</div>
      <h2 class="font-display text-4xl font-black text-gray-900 mb-3">Cities We Serve</h2>
      <p class="text-gray-500">Expanding across Gujarat — one city at a time</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5">
      {% for city in cities %}
      <a href="{{ url('core:pandit_list') }}?city={{ city.slug }}"
         class="group bg-white rounded-2xl p-6 text-center shadow-sm border border-gray-100 hover:shadow-xl hover:border-orange-200 hover:-translate-y-1 transition-all duration-200">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-50 to-orange-100 group-hover:from-orange-500 group-hover:to-brand-700 flex items-center justify-center text-2xl mx-auto mb-3 shadow-sm transition-all duration-200">
          🏛️
        </div>
        <h3 class="font-bold text-gray-900 group-hover:text-orange-600 transition-colors text-sm">{{ city.name }}</h3>
        <p class="text-xs text-gray-400 mt-0.5">{{ city.state }}</p>
        <div class="mt-2 text-xs font-bold text-orange-500 opacity-0 group-hover:opacity-100 transition-opacity">
          Browse →
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     TESTIMONIALS
═══════════════════════════════════════════════════════════════ -->
<section class="py-24 bg-gradient-to-br from-[#1a0a00] via-[#3d1400] to-[#6b2800] relative overflow-hidden">
  <div class="absolute inset-0 opacity-10" style="background-image:url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23f97316%22 fill-opacity=%220.4%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-orange-300 text-xs font-bold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider">💬 What Families Say</div>
      <h2 class="font-display text-4xl font-black text-white mb-3">Loved by Thousands</h2>
      <p class="text-white/50 max-w-lg mx-auto">Real reviews from real families across Gujarat</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {% for name, city, text, rating in [
        ('Rajesh Mehta', 'Surat', 'We booked Pt. Ram Shastri for our Griha Pravesh through SD Pandit Jee. He was extremely professional and performed the ceremony beautifully. Highly recommend!', 5),
        ('Priya Shah', 'Ahmedabad', 'Excellent service! Found the perfect pandit for our daughter\'s Namakaran ceremony. The booking process was super simple and the pandit arrived on time.', 5),
        ('Suresh Patel', 'Vadodara', 'Used SD Pandit Jee for our annual Satyanarayan puja. The pandit was knowledgeable, respectful and performed everything exactly as per tradition.', 5),
      ] %}
      <div class="bg-white/5 backdrop-blur border border-white/15 rounded-2xl p-6 hover:bg-white/10 transition-colors">
        <div class="flex mb-3">
          {% for i in range(rating) %}<span class="text-yellow-400 text-sm">★</span>{% endfor %}
        </div>
        <p class="text-white/75 text-sm leading-relaxed mb-5 italic">"{{ text }}"</p>
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 flex items-center justify-center text-white font-bold text-sm shadow-md">{{ name[0] }}</div>
          <div>
            <p class="text-white font-semibold text-sm">{{ name }}</p>
            <p class="text-white/40 text-xs">{{ city }}, Gujarat</p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════════
     WHY CHOOSE US
═══════════════════════════════════════════════════════════════ -->
<section class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
