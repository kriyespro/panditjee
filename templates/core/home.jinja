{% extends 'base.jinja' %}

{% block content %}

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- HERO                                                                -->
<!-- ─────────────────────────────────────────────────────────────────── -->
<section class="relative overflow-hidden">
  <!-- Background layers -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600"></div>
  <!-- Geometric accents -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full bg-white opacity-[0.03] translate-x-64 -translate-y-64"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full bg-saffron-500 opacity-[0.08] -translate-x-32 translate-y-32"></div>
  <!-- Grid overlay -->
  <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 32px 32px;"></div>
  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[#f8f8f8]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-32">
    <div class="max-w-3xl">

      <!-- Trust badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-1.5 mb-8 text-sm text-white font-medium">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
        </span>
        Trusted by 5,000+ families across Gujarat
      </div>

      <!-- Headline -->
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] mb-6">
        Book the<br />
        <span class="relative">
          <span class="text-saffron-400">Perfect Pandit</span>
          <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-saffron-400 opacity-40 rounded-full"></span>
        </span><br />
        for Every Puja
      </h1>
      <p class="text-white/70 text-lg md:text-xl leading-relaxed mb-10 max-w-2xl">
        Connect with verified, experienced pandits in Surat, Ahmedabad &amp; Vadodara for all your sacred ceremonies — at your doorstep.
      </p>

      <!-- Search box -->
      <div class="bg-white rounded-2xl p-2 shadow-2xl flex flex-col sm:flex-row gap-2 max-w-2xl">
        <div class="flex-1 flex items-center gap-2 px-3">
          <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657l-4.243 4.243m0 0L17.657 7.343M13.414 20.9L7.343 17.657"/></svg>
          <select name="city" form="search-form"
                  class="flex-1 py-3 text-sm text-gray-700 bg-transparent border-none outline-none font-medium">
            <option value="">Select City</option>
            {% for city in cities %}
            <option value="{{ city.slug }}">{{ city.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="hidden sm:block w-px bg-gray-100 self-stretch my-2"></div>
        <div class="flex-1 flex items-center gap-2 px-3">
          <span class="text-gray-400 text-base shrink-0">🕉️</span>
          <select name="puja" form="search-form"
                  class="flex-1 py-3 text-sm text-gray-700 bg-transparent border-none outline-none font-medium">
            <option value="">Select Puja Type</option>
            {% for cat in categories %}
            <option value="{{ cat.slug }}">{{ cat.name }}</option>
            {% endfor %}
          </select>
        </div>
        <form id="search-form" action="{{ url('core:pandit_list') }}" method="GET">
          <button type="submit" class="btn-primary py-3 px-6 text-sm rounded-xl whitespace-nowrap w-full sm:w-auto">
            Find Pandit →
          </button>
        </form>
      </div>

      <!-- Quick-search chips -->
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="text-white/50 text-xs self-center mr-1 font-medium uppercase tracking-wider">Popular:</span>
        {% for cat in categories[:5] %}
        <a href="{{ url('core:pandit_list') }}?puja={{ cat.slug }}"
           class="inline-flex items-center gap-1.5 text-xs font-medium bg-white/10 hover:bg-white/20 text-white border border-white/15 px-3 py-1.5 rounded-full transition-all duration-150 backdrop-blur-sm">
          {{ cat.icon }} {{ cat.name }}
        </a>
        {% else %}
        {% for label in ['🙏 Satyanarayan Puja','💍 Wedding Puja','🏠 Griha Pravesh','🔥 Havan & Yagya'] %}
        <a href="{{ url('core:pandit_list') }}" class="inline-flex items-center gap-1.5 text-xs font-medium bg-white/10 hover:bg-white/20 text-white border border-white/15 px-3 py-1.5 rounded-full transition-all duration-150 backdrop-blur-sm">
          {{ label }}
        </a>
        {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- TRUST STATS                                                         -->
<!-- ─────────────────────────────────────────────────────────────────── -->
<section class="relative -mt-14 z-20 max-w-5xl mx-auto px-4">
  <div class="bg-white rounded-2xl shadow-glass border border-gray-100 grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-gray-100">
    {% for stat in [('200+','Verified Pandits','🕉️'),('5,000+','Happy Families','❤️'),('3','Cities Served','📍'),('4.9 ★','Average Rating','⭐')] %}
    <div class="flex flex-col items-center py-6 px-4 text-center">
      <span class="text-2xl mb-1">{{ stat[2] }}</span>
      <span class="text-2xl font-bold text-gray-900 font-display">{{ stat[0] }}</span>
      <span class="text-xs text-gray-500 mt-0.5 font-medium">{{ stat[1] }}</span>
    </div>
    {% endfor %}
  </div>
</section>

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- PUJA CATEGORIES                                                      -->
<!-- ─────────────────────────────────────────────────────────────────── -->
<section class="py-20 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="section-tag">✦ All Ceremonies</div>
      <h2 class="section-title">Puja Categories</h2>
      <p class="section-sub max-w-xl mx-auto">From everyday pujas to grand ceremonies — we have a verified pandit for every occasion</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {% for cat in categories %}
      <a href="{{ url('core:pandit_list') }}?puja={{ cat.slug }}"
         class="group card p-5 flex flex-col items-center text-center">
        <div class="w-14 h-14 bg-brand-50 group-hover:bg-brand-600 rounded-2xl flex items-center justify-center text-3xl mb-3 transition-all duration-250 shadow-sm group-hover:shadow-md group-hover:scale-110">
          {{ cat.icon }}
        </div>
        <h3 class="text-sm font-semibold text-gray-800 group-hover:text-brand-600 transition-colors leading-tight">{{ cat.name }}</h3>
      </a>
      {% else %}
      {% for cat in [('🙏','Satyanarayan Puja'),('🔥','Havan & Yagya'),('💍','Wedding Puja'),('🏠','Griha Pravesh'),('👶','Naming Ceremony'),('🐘','Ganesh Puja'),('🪔','Diwali Puja'),('⚰️','Antim Sanskar'),('🌸','Navratri Puja'),('📿','Katha')] %}
      <a href="{{ url('core:pandit_list') }}" class="group card p-5 flex flex-col items-center text-center">
        <div class="w-14 h-14 bg-brand-50 group-hover:bg-brand-600 rounded-2xl flex items-center justify-center text-3xl mb-3 transition-all duration-250 shadow-sm">{{ cat[0] }}</div>
        <h3 class="text-sm font-semibold text-gray-800 group-hover:text-brand-600 transition-colors">{{ cat[1] }}</h3>
      </a>
      {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- HOW IT WORKS                                                        -->
<!-- ─────────────────────────────────────────────────────────────────── -->
<section id="how-it-works" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <div class="section-tag">✦ Simple Process</div>
      <h2 class="section-title">Book in 3 Easy Steps</h2>
      <p class="section-sub max-w-lg mx-auto">No calls, no hassle. Book a verified pandit online in minutes.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
      <!-- Connector lines (desktop only) -->
      <div class="hidden md:block absolute top-14 left-1/3 right-1/3 h-px bg-gradient-to-r from-gray-100 via-brand-200 to-gray-100"></div>

      {% for step in [
        ('01', '🔍', 'Search', 'Choose your city and select the puja type you need.', 'from-blue-500 to-blue-600'),
        ('02', '🙏', 'Choose Pandit', 'Browse profiles, read reviews, compare prices and experience.', 'from-brand-500 to-brand-700'),
        ('03', '✅', 'Book & Confirm', 'Pick a date and time — get instant booking confirmation.', 'from-green-500 to-green-600'),
      ] %}
      <div class="card p-8 relative text-center group">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-brand-600 text-white text-xs font-bold flex items-center justify-center shadow-md border-2 border-white">
          {{ step[0] }}
        </div>
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br {{ step[4] }} flex items-center justify-center text-3xl mx-auto mb-5 mt-3 shadow-md">
          {{ step[1] }}
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2 font-display">{{ step[2] }}</h3>
        <p class="text-gray-500 text-sm leading-relaxed">{{ step[3] }}</p>
      </div>
      {% endfor %}
    </div>

    <div class="text-center mt-10">
      <a href="{{ url('core:pandit_list') }}" class="btn-primary py-3 px-8 text-base">Find a Pandit Now →</a>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- FEATURED PANDITS                                                     -->
<!-- ─────────────────────────────────────────────────────────────────── -->
{% if featured_pandits is defined and featured_pandits %}
<section class="py-20 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between mb-12">
      <div>
        <div class="section-tag">✦ Top Rated</div>
        <h2 class="section-title">Featured Pandits</h2>
      </div>
      <a href="{{ url('core:pandit_list') }}" class="btn-ghost text-sm hidden md:flex">View All →</a>
    </div>
    <!-- pandit cards would go here -->
  </div>
</section>
{% endif %}

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- CITIES                                                              -->
<!-- ─────────────────────────────────────────────────────────────────── -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <div class="section-tag">✦ Service Areas</div>
      <h2 class="section-title">Cities We Serve</h2>
      <p class="section-sub">Expanding across Gujarat — one city at a time</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-3xl mx-auto">
      {% for city in cities %}
      <a href="{{ url('core:pandit_list') }}?city={{ city.slug }}"
         class="group card p-8 text-center">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 group-hover:bg-brand-600 flex items-center justify-center text-3xl mx-auto mb-4 transition-all duration-250 shadow-sm">
          📍
        </div>
        <h3 class="text-lg font-bold text-gray-900 group-hover:text-brand-600 transition-colors font-display mb-1">{{ city.name }}</h3>
        <p class="text-sm text-gray-500">{{ city.state }}</p>
        <div class="mt-3 text-xs font-semibold text-brand-600 opacity-0 group-hover:opacity-100 transition-opacity">
          Browse Pandits →
        </div>
      </a>
      {% else %}
      {% for city in [('Surat','Gujarat'),('Ahmedabad','Gujarat'),('Vadodara','Gujarat')] %}
      <a href="{{ url('core:pandit_list') }}" class="group card p-8 text-center">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 group-hover:bg-brand-600 flex items-center justify-center text-3xl mx-auto mb-4 transition-all duration-250 shadow-sm">📍</div>
        <h3 class="text-lg font-bold text-gray-900 group-hover:text-brand-600 transition-colors font-display mb-1">{{ city[0] }}</h3>
        <p class="text-sm text-gray-500">{{ city[1] }}</p>
      </a>
      {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- WHY CHOOSE US                                                       -->
<!-- ─────────────────────────────────────────────────────────────────── -->
<section class="py-20 bg-[#f8f8f8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
      <div>
        <div class="section-tag">✦ Why Us</div>
        <h2 class="section-title mb-6">The Trusted Way to Book Pandits</h2>
        <div class="space-y-5">
          {% for item in [
            ('✅','Verified & Experienced','Every pandit is background-checked and verified by our team before joining the platform.'),
            ('⭐','Rated & Reviewed','Read genuine reviews from real customers before you book. No fake ratings.'),
            ('💳','Secure Payments','Pay securely online. Your money is safe with our escrow system.'),
            ('📱','Easy Booking','Book in minutes from your phone — no calls, no negotiations.'),
          ] %}
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-100 flex items-center justify-center text-xl shrink-0">{{ item[0] }}</div>
            <div>
              <h4 class="font-bold text-gray-900 text-base">{{ item[1] }}</h4>
              <p class="text-gray-500 text-sm mt-0.5 leading-relaxed">{{ item[2] }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      <!-- Illustration / CTA card -->
      <div class="bg-gradient-to-br from-brand-600 to-brand-900 rounded-2xl p-10 text-white text-center shadow-xl relative overflow-hidden">
        <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px); background-size: 24px 24px;"></div>
        <div class="relative">
          <div class="text-6xl mb-6">🕉️</div>
          <h3 class="font-display text-2xl font-bold mb-3">Are You a Pandit?</h3>
          <p class="text-white/70 text-sm leading-relaxed mb-8">Join our platform and receive bookings from devotees across Gujarat. Zero commission for the first 3 months.</p>
          <a href="{{ url('users:register_pandit') }}"
             class="inline-flex items-center gap-2 bg-white text-brand-700 font-bold px-7 py-3.5 rounded-xl hover:bg-gray-50 transition-colors shadow-lg text-sm">
            Register as Pandit →
          </a>
          <p class="text-white/40 text-xs mt-5">100+ pandits already earning on our platform</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────────────────────────────── -->
<!-- CTA BANNER                                                          -->
<!-- ─────────────────────────────────────────────────────────────────── -->
<section class="relative overflow-hidden bg-brand-600 py-16">
  <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 28px 28px;"></div>
  <div class="relative max-w-4xl mx-auto px-4 text-center">
    <div class="font-display text-3xl md:text-4xl font-bold text-white mb-4">
      Ready to Book Your Pandit?
    </div>
    <p class="text-white/70 mb-8 text-lg max-w-xl mx-auto">Join thousands of families who book verified pandits on SD Pandit Jee.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="{{ url('users:register_client') }}"
         class="inline-flex items-center justify-center gap-2 bg-white text-brand-700 font-bold px-8 py-4 rounded-xl hover:bg-gray-50 transition-colors shadow-lg text-base">
        🙏 Book a Pandit Now
      </a>
      <a href="{{ url('core:pandit_list') }}"
         class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white font-semibold px-8 py-4 rounded-xl hover:bg-white/10 transition-colors text-base">
        Browse Pandits
      </a>
    </div>
  </div>
</section>

{% endblock %}
