{% extends 'base.jinja' %}

{% block content %}

<!-- Page Header -->
<div class="bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <h1 class="font-display text-2xl font-bold text-gray-900">Find a Pandit</h1>
    <p class="text-gray-500 text-sm mt-1">Browse verified pandits available in your city</p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col lg:flex-row gap-6">

    <!-- ── Sidebar Filters ─────────────────────────────────── -->
    <aside class="lg:w-64 shrink-0">
      <form method="GET" id="filter-form">
        <div class="card p-5 sticky top-20 space-y-5">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-gray-900 text-sm">Filters</h3>
            <a href="{{ url('core:pandit_list') }}" class="text-xs text-brand-600 font-semibold hover:text-brand-700">Clear All</a>
          </div>

          <!-- City filter -->
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">City</label>
            <div class="space-y-1.5">
              {% for city in cities %}
              <label class="flex items-center gap-2.5 cursor-pointer group">
                <input type="radio" name="city" value="{{ city.slug }}"
                       {{ 'checked' if selected_city and selected_city.slug == city.slug }}
                       class="accent-brand-600"
                       onchange="document.getElementById('filter-form').submit()" />
                <span class="text-sm text-gray-700 group-hover:text-brand-600 transition-colors font-medium">{{ city.name }}</span>
              </label>
              {% endfor %}
            </div>
          </div>

          <!-- Puja category filter -->
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Puja Type</label>
            <div class="space-y-1.5 max-h-52 overflow-y-auto pr-1">
              {% for cat in categories %}
              <label class="flex items-center gap-2.5 cursor-pointer group">
                <input type="radio" name="puja" value="{{ cat.slug }}"
                       {{ 'checked' if selected_puja and selected_puja.slug == cat.slug }}
                       class="accent-brand-600"
                       onchange="document.getElementById('filter-form').submit()" />
                <span class="text-sm text-gray-700 group-hover:text-brand-600 transition-colors">{{ cat.icon }} {{ cat.name }}</span>
              </label>
              {% endfor %}
            </div>
          </div>

          <!-- Price range -->
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Price Range (₹)</label>
            <div class="flex gap-2">
              <input type="number" name="min_price" placeholder="Min" value="{{ min_price }}" class="form-input text-xs py-1.5 px-2 w-full">
              <input type="number" name="max_price" placeholder="Max" value="{{ max_price }}" class="form-input text-xs py-1.5 px-2 w-full">
            </div>
          </div>

          <!-- Language -->
          <div>
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Language</label>
            <input type="text" name="language" placeholder="e.g. Hindi" value="{{ language }}" class="form-input text-xs py-1.5">
          </div>

          <button type="submit" class="btn-primary w-full justify-center text-sm py-2.5">Apply Filters</button>
        </div>
      </form>
    </aside>

    <!-- ── Pandit Grid ─────────────────────────────────────── -->
    <div class="flex-1">

      <!-- Active filters bar -->
      {% if selected_city or selected_puja %}
      <div class="flex items-center gap-2 flex-wrap mb-5 p-3 bg-brand-50 border border-brand-100 rounded-xl text-sm">
        <span class="text-gray-600 font-medium">Showing for:</span>
        {% if selected_city %}
        <span class="badge badge-danger">📍 {{ selected_city.name }} ×</span>
        {% endif %}
        {% if selected_puja %}
        <span class="badge badge-danger">{{ selected_puja.icon }} {{ selected_puja.name }} ×</span>
        {% endif %}
        <span class="text-gray-500 ml-1">({{ page_obj.paginator.count }} pandits found)</span>
      </div>
      {% endif %}

      {% if pandits %}
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
        {% for pandit in pandits %}
        <article class="card overflow-hidden flex flex-col group">
          <!-- Card top accent bar -->
          <div class="h-1 bg-gradient-to-r from-brand-500 to-saffron-500"></div>

          <div class="p-5 flex-1 flex flex-col">
            <!-- Header -->
            <div class="flex items-start gap-3 mb-4">
              {% if pandit.user.profile_image %}
              <img src="{{ pandit.user.profile_image.url }}"
                   class="w-14 h-14 rounded-xl object-cover shadow-sm ring-2 ring-brand-100 shrink-0" />
              {% else %}
              <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-2xl shadow-sm shrink-0">
                🙏
              </div>
              {% endif %}
              <div class="flex-1 min-w-0">
                <h2 class="font-bold text-gray-900 text-sm leading-tight truncate">Pt. {{ pandit.user.get_full_name() }}</h2>
                {% if pandit.city %}
                <p class="text-xs text-gray-500 mt-0.5">📍 {{ pandit.city.name }}</p>
                {% endif %}
                <!-- Stars -->
                <div class="flex items-center gap-1 mt-1.5">
                  <div class="flex">
                    {% for i in range(5) %}
                    <svg class="w-3 h-3 {{ 'text-yellow-400' if i < pandit.average_rating|int else 'text-gray-200' }}" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    {% endfor %}
                  </div>
                  <span class="text-xs font-semibold text-gray-700">{{ pandit.average_rating }}</span>
                  <span class="text-xs text-gray-400">({{ pandit.total_bookings }})</span>
                </div>
              </div>
            </div>

            <!-- Details chips -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="inline-flex items-center gap-1 text-xs bg-gray-50 border border-gray-100 text-gray-600 px-2.5 py-1 rounded-lg font-medium">
                ⏳ {{ pandit.experience_years }}+ yrs
              </span>
              <span class="inline-flex items-center gap-1 text-xs bg-gray-50 border border-gray-100 text-gray-600 px-2.5 py-1 rounded-lg font-medium">
                🗣️ {{ pandit.languages.split(',')[0] }}
              </span>
              {% if pandit.specializations.all() %}
              {% for spec in pandit.specializations.all()[:2] %}
              <span class="inline-flex items-center gap-1 text-xs bg-brand-50 border border-brand-100 text-brand-700 px-2.5 py-1 rounded-lg font-medium">
                {{ spec.icon }} {{ spec.name }}
              </span>
              {% endfor %}
              {% endif %}
            </div>

            <!-- Price & CTA -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-50 mt-auto">
              <div>
                <p class="text-xs text-gray-400 font-medium">Starting from</p>
                <p class="text-xl font-bold text-brand-600 font-display">₹{{ pandit.base_price }}</p>
              </div>
              <a href="{{ url('core:pandit_detail', slug=pandit.slug) }}"
                 class="btn-primary py-2 px-4 text-xs">View Profile →</a>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>

      <!-- Pagination -->
      {% if page_obj.paginator.num_pages > 1 %}
      <div class="flex items-center justify-center gap-2 mt-8">
        {% if page_obj.has_previous() %}
        <a href="?page={{ page_obj.previous_page_number() }}&city={{ selected_city.slug if selected_city else '' }}&puja={{ selected_puja.slug if selected_puja else '' }}&min_price={{ min_price }}&max_price={{ max_price }}&language={{ language }}"
           class="px-4 py-2 text-sm font-medium border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">← Prev</a>
        {% endif %}
        {% for num in page_obj.paginator.page_range %}
          {% if num == page_obj.number %}
          <span class="px-4 py-2 text-sm font-bold bg-brand-600 text-white rounded-lg">{{ num }}</span>
          {% elif num > page_obj.number - 3 and num < page_obj.number + 3 %}
          <a href="?page={{ num }}&city={{ selected_city.slug if selected_city else '' }}&puja={{ selected_puja.slug if selected_puja else '' }}&min_price={{ min_price }}&max_price={{ max_price }}&language={{ language }}"
             class="px-4 py-2 text-sm font-medium border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">{{ num }}</a>
          {% endif %}
        {% endfor %}
        {% if page_obj.has_next() %}
        <a href="?page={{ page_obj.next_page_number() }}&city={{ selected_city.slug if selected_city else '' }}&puja={{ selected_puja.slug if selected_puja else '' }}&min_price={{ min_price }}&max_price={{ max_price }}&language={{ language }}"
           class="px-4 py-2 text-sm font-medium border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">Next →</a>
        {% endif %}
      </div>
      {% endif %}

      {% else %}
      <!-- Empty state -->
      <div class="text-center py-24 card p-12">
        <div class="text-6xl mb-4">🔍</div>
        <h3 class="font-display text-xl font-bold text-gray-900 mb-2">No Pandits Found</h3>
        <p class="text-gray-500 text-sm mb-6 max-w-sm mx-auto">Try removing city or puja filters to see more pandits available on the platform.</p>
        <a href="{{ url('core:pandit_list') }}" class="btn-primary">Browse All Pandits</a>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
