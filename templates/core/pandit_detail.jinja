{% extends 'base.jinja' %}

{% block content %}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Left: Profile Card -->
    <div class="lg:col-span-1">
      <div class="card p-6 text-center sticky top-24">
        {% if pandit.user.profile_image %}
        <img src="{{ pandit.user.profile_image.url }}" class="w-28 h-28 rounded-2xl object-cover mx-auto mb-4 shadow-md" />
        {% else %}
        <div class="w-28 h-28 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-5xl mx-auto mb-4 shadow-md">🙏</div>
        {% endif %}

        <h1 class="text-xl font-bold text-gray-900">Pt. {{ pandit.user.get_full_name() }}</h1>
        {% if pandit.city %}
        <p class="text-sm text-gray-500 mt-1">📍 {{ pandit.city.name }}, {{ pandit.city.state }}</p>
        {% endif %}

        <!-- Rating -->
        <div class="flex items-center justify-center gap-1 mt-3">
          {% for i in range(5) %}
          <span class="{{ 'text-yellow-400' if i < pandit.average_rating|int else 'text-gray-200' }} text-lg">★</span>
          {% endfor %}
          <span class="text-sm text-gray-600 ml-1">({{ pandit.total_bookings }} bookings)</span>
        </div>

        <div class="border-t border-gray-100 mt-4 pt-4 space-y-2 text-sm text-left">
          <div class="flex items-center gap-2 text-gray-600">
            <span class="text-brand-600 w-5">⏳</span>
            <span>{{ pandit.experience_years }}+ years experience</span>
          </div>
          <div class="flex items-center gap-2 text-gray-600">
            <span class="text-brand-600 w-5">🗣️</span>
            <span>{{ pandit.languages }}</span>
          </div>
        </div>

        <!-- Booking CTA Sticky Card -->
        <div class="card p-6 sticky top-24 border-2 border-brand-100 bg-gradient-to-br from-white to-brand-50 mt-6">
          <h3 class="font-bold text-gray-900 text-lg mb-2">Book Pandit Ji</h3>
          <p class="text-xs text-gray-500 mb-5">Secure your date for the ceremony. Pay instantly or give Cash on Delivery.</p>
          
          <div class="flex items-end justify-between mb-6 pb-6 border-b border-brand-100">
            <span class="text-sm text-gray-500 font-medium">Starting from</span>
            <span class="font-display text-3xl font-bold text-brand-600">₹{{ pandit.base_price }}</span>
          </div>
          
          {% if request.user.is_authenticated and request.user.role == 'CLIENT' %}
          <a href="{{ url('bookings:checkout', pandit_slug=pandit.slug) }}" class="btn-primary w-full justify-center py-4 text-base shadow-md">
            🙏 Book Now
          </a>
          {% elif request.user.is_authenticated %}
          <button disabled class="btn-outline w-full justify-center py-4 text-sm opacity-50 cursor-not-allowed">
            Log in as Client to book
          </button>
          {% else %}
          <a href="{{ url('users:login') }}?next={{ request.path }}" class="btn-primary w-full justify-center py-4 text-sm shadow-md">
            Log in to Book
          </a>
          {% endif %}
          
          <p class="text-xs text-center text-gray-500 mt-4 flex items-center justify-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-[10px]">✔</span>
            Verified Profile & Secure Booking
          </p>
        </div>
      </div>
    </div>

    <!-- Right: Details -->
    <div class="lg:col-span-2 space-y-6">

      <!-- Bio -->
      {% if pandit.bio %}
      <div class="card p-6">
        <h2 class="font-bold text-gray-900 text-lg mb-3">About Pandit Ji</h2>
        <p class="text-gray-600 text-sm leading-relaxed">{{ pandit.bio }}</p>
      </div>
      {% endif %}

      <!-- Puja Services & Prices -->
      <div class="card p-6">
        <h2 class="font-bold text-gray-900 text-lg mb-4">Puja Services & Prices</h2>
        {% if pandit.specializations.all() %}
        <div class="space-y-3">
          {% for spec in pandit.specializations.all() %}
          <div class="flex items-center justify-between py-3 border-b border-gray-50 last:border-0">
            <div class="flex items-center gap-3">
              <span class="text-2xl">{{ spec.icon }}</span>
              <span class="font-medium text-gray-800 text-sm">{{ spec.name }}</span>
            </div>
            <span class="font-bold text-brand-600">₹{{ pandit.base_price }}</span>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <p class="text-gray-500 text-sm">Contact for pricing details. Starting from ₹{{ pandit.base_price }}</p>
        {% endif %}
      </div>

      <!-- Specializations -->
      {% if pandit.specializations.all() %}
      <div class="card p-6">
        <h2 class="font-bold text-gray-900 text-lg mb-4">Specializations</h2>
        <div class="flex flex-wrap gap-2">
          {% for spec in pandit.specializations.all() %}
          <span class="bg-red-50 text-brand-700 border border-red-100 text-sm px-4 py-1.5 rounded-full font-medium">
            {{ spec.icon }} {{ spec.name }}
          </span>
          {% endfor %}
        </div>
      </div>
      {% endif %}

    </div>
  </div>
</div>
{% endblock %}
