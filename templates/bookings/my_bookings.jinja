{% extends 'base.jinja' %}

{% block content %}
<div class="bg-gray-50 min-h-[80vh] py-10 px-4">
  <div class="max-w-5xl mx-auto">
    
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="font-display text-3xl font-bold text-gray-900">My Bookings</h1>
        <p class="text-gray-500 text-sm mt-1">Manage your upcoming and past pujas</p>
      </div>
      <a href="{{ url('core:pandit_list') }}" class="btn-primary text-sm">Book Another Pandit</a>
    </div>

    {% if bookings %}
    <div class="space-y-4">
      {% for booking in bookings %}
      <div class="card p-6 flex flex-col md:flex-row gap-6 items-start relative overflow-hidden group">
        
        <!-- Status Ribbon -->
        <div class="absolute top-0 right-0 px-4 py-1 text-xs font-bold text-white shadow-sm
                    {% if booking.status == 'PENDING' %}bg-yellow-500
                    {% elif booking.status == 'CONFIRMED' %}bg-blue-500
                    {% elif booking.status == 'COMPLETED' %}bg-green-600
                    {% elif booking.status == 'CANCELLED' %}bg-red-500
                    {% elif booking.status == 'REFUNDED' %}bg-gray-500{% endif %}
                    rounded-bl-xl z-10">
          {{ booking.status }}
        </div>

        <!-- Pandit Info -->
        <div class="flex gap-4 shrink-0 w-full md:w-64">
          {% if booking.pandit.user.profile_image %}
          <img src="{{ booking.pandit.user.profile_image.url }}" class="w-16 h-16 rounded-xl object-cover shrink-0" />
          {% else %}
          <div class="w-16 h-16 rounded-xl bg-brand-100 text-brand-700 flex items-center justify-center text-2xl font-bold shrink-0">
            {{ booking.pandit.user.first_name[0].upper() }}
          </div>
          {% endif %}
          
          <div>
            <h3 class="font-bold text-gray-900 text-base mb-1">Pt. {{ booking.pandit.user.get_full_name() }}</h3>
            <p class="text-xs text-gray-500 break-all mb-1">Booking ID: <br/> <span class="font-mono text-gray-900">{{ booking.booking_id|string|truncate(8, False, '')|upper }}</span></p>
            <p class="text-xs text-gray-500">Booked on: {{ booking.created_at.strftime('%d %b %Y') }}</p>
          </div>
        </div>

        <div class="w-full md:w-px h-px md:h-20 bg-gray-100 shrink-0"></div>

        <!-- Ceremony Details -->
        <div class="flex-1 space-y-3 pl-0 md:pl-2">
          <div>
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Ceremony</p>
            <p class="font-bold text-gray-900">{{ booking.puja_category.name if booking.puja_category else 'General Puja' }}</p>
          </div>
          <div class="flex gap-8">
            <div>
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Date & Time</p>
              <p class="text-sm font-medium text-gray-800">📅 {{ booking.puja_date }} at ⏰ {{ booking.puja_time.strftime('%I:%M %p') }}</p>
            </div>
          </div>
        </div>

        <!-- Payment & Actions -->
        <div class="shrink-0 flex flex-col items-end w-full md:w-32">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Amount</p>
          <p class="font-display font-bold text-xl text-brand-600 mb-2">₹{{ booking.amount }}</p>
          <p class="text-xs text-gray-500 mb-4 bg-gray-100 px-2 py-0.5 rounded">{{ booking.get_payment_mode_display() }}</p>

          {% if booking.status in ['PENDING', 'CONFIRMED'] %}
          <form method="POST" action="{{ url('bookings:cancel', booking_id=booking.booking_id) }}" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
            {{ csrf_input }}
            <button type="submit" class="text-red-600 hover:text-red-700 text-xs font-semibold underline decoration-red-300 underline-offset-4">
              Cancel Booking
            </button>
          </form>
          {% elif booking.status == 'COMPLETED' %}
            {% if booking.review %}
            <div class="text-xs text-yellow-600 font-bold bg-yellow-50 px-2 py-1 rounded border border-yellow-100 text-center w-full">
              ★ {{ booking.review.rating }} Rated
            </div>
            {% else %}
            <a href="{{ url('reviews:create', booking_id=booking.booking_id) }}" class="btn-outline text-xs px-3 py-1.5 w-full text-center">Leave Review</a>
            {% endif %}
          {% endif %}
        </div>
        
      </div>
      {% endfor %}
    </div>

    {% else %}
    <!-- Empty State -->
    <div class="card p-12 text-center py-20">
      <div class="text-6xl mb-4 opacity-50">📿</div>
      <h3 class="font-display text-xl font-bold text-gray-900 mb-2">No Bookings Yet</h3>
      <p class="text-gray-500 text-sm mb-6 max-w-sm mx-auto">You haven't booked any ceremonies yet. Find a verified pandit and schedule your first puja.</p>
      <a href="{{ url('core:pandit_list') }}" class="btn-primary">Browse Pandits</a>
    </div>
    {% endif %}

  </div>
</div>
{% endblock %}
