{% extends 'base.jinja' %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 flex">

  <!-- Left panel — branding (desktop only) -->
  <div class="hidden lg:flex w-1/2 bg-gradient-to-br from-brand-900 via-brand-700 to-brand-600 flex-col justify-between p-12 relative overflow-hidden">
    <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="relative">
      <a href="{{ url('core:home') }}" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center text-2xl backdrop-blur-sm">🕉️</div>
        <span class="font-bold text-white text-lg">SD PanditJee</span>
      </a>
    </div>
    <div class="relative">
      <h2 class="font-display text-4xl font-bold text-white leading-tight mb-4">
        Sacred ceremonies<br/>deserve the best Pandit.
      </h2>
      <p class="text-white/60 text-base leading-relaxed max-w-sm">
        Join thousands of families who trust us for their puja bookings across Gujarat.
      </p>
      <!-- Testimonial -->
      <div class="mt-10 bg-white/10 backdrop-blur-sm rounded-2xl p-5 border border-white/15">
        <p class="text-white/80 text-sm italic leading-relaxed">"Booked a pandit for our griha pravesh in just 5 minutes. The experience was seamless and the pandit was wonderful."</p>
        <div class="flex items-center gap-3 mt-4">
          <div class="w-8 h-8 rounded-full bg-saffron-400 flex items-center justify-center text-white font-bold text-sm">R</div>
          <div>
            <div class="text-white text-sm font-semibold">Rahul Mehta</div>
            <div class="text-white/50 text-xs">Surat, Gujarat</div>
          </div>
        </div>
      </div>
    </div>
    <div class="relative text-white/30 text-xs">© 2024 SD PanditJee</div>
  </div>

  <!-- Right panel — form -->
  <div class="flex-1 flex items-center justify-center py-12 px-6 lg:px-16">
    <div class="w-full max-w-md">
      <!-- Mobile logo -->
      <div class="lg:hidden text-center mb-8">
        <div class="w-14 h-14 bg-brand-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-3 shadow-lg">🕉️</div>
        <h1 class="font-display text-2xl font-bold text-gray-900">SD PanditJee</h1>
      </div>

      <div class="mb-8">
        <h2 class="font-display text-2xl font-bold text-gray-900">Welcome back 🙏</h2>
        <p class="text-gray-500 text-sm mt-1">Sign in to your account</p>
      </div>

      <form method="POST" action="{{ url('users:login') }}" class="space-y-4">
        {{ csrf_input }}

        <div>
          <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1.5">Email Address</label>
          <input type="email" name="email" id="id_email" placeholder="you@example.com"
                 value="{{ form.email.value() or '' }}" required class="input-field" />
          {% if form.email.errors %}
          <p class="text-xs text-red-500 mt-1">{{ form.email.errors | join(', ') }}</p>{% endif %}
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Password</label>
            <a href="{{ url('users:forgot_password') }}" class="text-xs text-brand-600 font-semibold hover:text-brand-700">Forgot password?</a>
          </div>
          <div class="relative" x-data="{ show: false }">
            <input :type="show ? 'text' : 'password'" name="password" id="id_password"
                   placeholder="••••••••" required class="input-field pr-11" />
            <button type="button" @click="show = !show"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 text-base transition-colors">
              <span x-text="show ? '🙈' : '👁️'"></span>
            </button>
          </div>
          {% if form.password.errors %}
          <p class="text-xs text-red-500 mt-1">{{ form.password.errors | join(', ') }}</p>{% endif %}
        </div>

        <button type="submit" class="btn-primary w-full justify-center py-3.5 text-sm mt-2">
          Sign In to Account →
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-gray-100 text-center text-sm text-gray-500">
        New to SD PanditJee?
        <a href="{{ url('users:register_client') }}" class="text-brand-600 font-bold hover:text-brand-700 ml-1">Create an account</a>
      </div>
      <div class="text-center text-sm text-gray-500 mt-2">
        Are you a pandit?
        <a href="{{ url('users:register_pandit') }}" class="text-brand-600 font-bold hover:text-brand-700 ml-1">Register here</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
