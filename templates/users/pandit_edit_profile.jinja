{% extends 'base.jinja' %}
{% block content %}
<div class="bg-gray-50 min-h-screen py-10">
  <div class="max-w-2xl mx-auto px-4">

    <div class="mb-8 flex items-center gap-4">
      <a href="{{ url('users:pandit_dashboard') }}" class="text-gray-500 hover:text-gray-700 text-sm">← Back to Dashboard</a>
    </div>

    <div class="card p-8">
      <h1 class="font-display text-2xl font-bold text-gray-900 mb-6 border-b border-gray-100 pb-4">Edit Your Profile</h1>

      <form method="POST" enctype="multipart/form-data" class="space-y-5">
        {{ csrf_input }}

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">First Name</label>
            {{ form.first_name }}
            {% if form.first_name.errors %}<p class="text-red-500 text-xs mt-1">{{ form.first_name.errors[0] }}</p>{% endif %}
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Last Name</label>
            {{ form.last_name }}
            {% if form.last_name.errors %}<p class="text-red-500 text-xs mt-1">{{ form.last_name.errors[0] }}</p>{% endif %}
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Phone</label>
            {{ form.phone }}
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">City</label>
            {{ form.city }}
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Experience (Years)</label>
            {{ form.experience_years }}
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Base Price (₹)</label>
            {{ form.base_price }}
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Languages Spoken</label>
          {{ form.languages }}
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Bio</label>
          {{ form.bio }}
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Specializations</label>
          <div class="grid grid-cols-2 gap-2">
            {% for checkbox in form.specializations %}
            <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
              {{ checkbox.tag() }}
              <span>{{ checkbox.choice_label }}</span>
            </label>
            {% endfor %}
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Profile Photo</label>
          <input type="file" name="profile_image" accept="image/*" class="form-input text-sm">
          {% if request.user.profile_image %}
          <p class="text-xs text-gray-500 mt-1">Current: <a href="{{ request.user.profile_image.url }}" target="_blank" class="text-brand-600 underline">View Photo</a></p>
          {% endif %}
        </div>

        {% if form.non_field_errors() %}
        <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-700">{{ form.non_field_errors()[0] }}</div>
        {% endif %}

        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary py-3 px-6">Save Changes</button>
          <a href="{{ url('users:pandit_dashboard') }}" class="btn-ghost py-3 px-6">Cancel</a>
        </div>
      </form>
    </div>

  </div>
</div>
{% endblock %}
