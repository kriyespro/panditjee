{% extends 'base.jinja' %}
{% block content %}
<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="text-4xl mb-3">🔑</div>
      <h1 class="font-display text-3xl font-bold text-gray-900">Forgot Password?</h1>
      <p class="text-gray-500 mt-2 text-sm">Enter your email and we'll send you a reset link.</p>
    </div>
    <div class="card p-8">
      <form method="POST">
        {{ csrf_input }}
        {% for field in form %}
        <div class="mb-5">
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">{{ field.label }}</label>
          {{ field }}
          {% if field.errors %}<p class="text-red-500 text-xs mt-1">{{ field.errors[0] }}</p>{% endif %}
        </div>
        {% endfor %}
        <button type="submit" class="btn-primary w-full justify-center py-3.5 text-base">
          Send Reset Link
        </button>
      </form>
      <div class="text-center mt-6">
        <a href="{{ url('users:login') }}" class="text-brand-600 text-sm font-medium hover:underline">Back to Login</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}
