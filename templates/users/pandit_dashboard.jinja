{% extends 'base.jinja' %}

{% block content %}
<div class="bg-gray-50 min-h-screen">
  
  <div class="bg-brand-900 border-b border-brand-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        {% if request.user.profile_image %}
        <img src="{{ request.user.profile_image.url }}" class="w-16 h-16 rounded-2xl object-cover ring-2 ring-white/20" />
        {% else %}
        <div class="w-16 h-16 rounded-2xl bg-saffron-500 text-white flex items-center justify-center text-2xl font-bold shadow-lg">
          {{ request.user.first_name[0].upper() }}
        </div>
        {% endif %}
        <div>
          <h1 class="font-display text-2xl font-bold text-white leading-tight">Welcome, Pt. {{ request.user.get_full_name() }}</h1>
          <p class="text-brand-200 text-sm mt-0.5">Manage your bookings, availability, and profile here.</p>
        </div>
      </div>
      <div>
        <a href="{{ url('core:pandit_detail', slug=request.user.panditprofile.slug) }}" class="btn-secondary bg-white text-brand-900 border-none hover:bg-gray-50 py-2.5 shadow-lg">
          View Public Profile
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Metrics & Quick Info -->
      <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        <div class="card p-5 border-l-4 border-l-brand-600">
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Total Earnings</p>
          <p class="font-display text-2xl font-bold text-gray-900 mt-1">₹{{ total_earnings }}</p>
        </div>
        <div class="card p-5 border-l-4 border-l-blue-500">
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Pending Bookings</p>
          <p class="font-display text-2xl font-bold text-gray-900 mt-1">{{ pending_count }}</p>
        </div>
        <div class="card p-5 border-l-4 border-l-green-500">
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Completed Bookings</p>
          <p class="font-display text-2xl font-bold text-gray-900 mt-1">{{ completed_count }}</p>
        </div>
        <div class="card p-5 border-l-4 border-l-yellow-400">
          <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Average Rating</p>
          <div class="flex items-center gap-1 mt-1 font-display text-2xl font-bold text-gray-900">
            <span class="text-yellow-400">★</span> {{ request.user.panditprofile.average_rating }}
          </div>
        </div>
      </div>

      <!-- Main Content Area: Bookings List -->
      <div class="lg:col-span-2 space-y-6">
        
        <div class="card p-6">
          <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-4">
            <h2 class="font-bold text-gray-900 text-lg">Upcoming & Pending Bookings</h2>
          </div>
          
          <div class="space-y-4">
            {% for booking in active_bookings %}
            <div class="border border-gray-100 rounded-xl p-4 bg-white flex flex-col md:flex-row justify-between gap-4 group hover:border-brand-200 transition-colors">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-bold px-2 py-0.5 rounded
                    {% if booking.status == 'PENDING' %}bg-yellow-100 text-yellow-800
                    {% elif booking.status == 'CONFIRMED' %}bg-blue-100 text-blue-800{% endif %}">
                    {{ booking.status }}
                  </span>
                  <span class="font-mono text-xs text-gray-400 border-l border-gray-200 pl-2">ID: {{ booking.booking_id|string|truncate(8, False, '')|upper }}</span>
                </div>
                <h3 class="font-bold text-gray-900 mb-0.5">{{ booking.puja_category.name if booking.puja_category else 'Puja' }}</h3>
                <p class="text-sm text-gray-600 font-medium tracking-tight">📅 {{ booking.puja_date }} at ⏰ {{ booking.puja_time.strftime('%I:%M %p') }}</p>
                <div class="flex items-center gap-2 mt-2 text-xs text-gray-500">
                  <span class="shrink-0">👤 {{ booking.client.get_full_name() }}</span>
                  <span class="text-gray-300">•</span>
                  <span class="shrink-0">📍 {{ booking.address | truncate(30) }}</span>
                </div>
                {% if booking.special_notes %}
                <p class="text-xs text-brand-600 bg-brand-50 p-2 rounded-lg mt-2 border border-brand-100">"{{ booking.special_notes }}"</p>
                {% endif %}
              </div>
              <div class="flex flex-col items-end justify-between border-t md:border-t-0 md:border-l border-gray-100 pt-3 md:pt-0 md:pl-4">
                <div class="text-right mb-3">
                  <p class="text-xs text-gray-400 font-semibold uppercase tracking-wide">Payout</p>
                  <p class="font-bold text-xl text-green-600">₹{{ booking.pandit_amount }}</p>
                  <p class="text-[10px] text-gray-400 mt-1">Total: ₹{{ booking.amount }} ({{ booking.get_payment_mode_display() }})</p>
                </div>
                
                <div class="flex flex-col w-full gap-2">
                  {% if booking.status == 'PENDING' %}
                  <form action="{{ url('users:pandit_action_booking', booking_id=booking.booking_id) }}" method="POST" class="w-full">
                    {{ csrf_input }}<input type="hidden" name="action" value="accept">
                    <button class="btn-primary w-full justify-center py-2 text-xs bg-green-600 hover:bg-green-700 shadow-none">Accept</button>
                  </form>
                  <form action="{{ url('users:pandit_action_booking', booking_id=booking.booking_id) }}" method="POST" class="w-full">
                    {{ csrf_input }}<input type="hidden" name="action" value="reject">
                    <button class="btn-ghost w-full justify-center py-2 text-xs text-red-600 hover:bg-red-50 border-gray-200">Reject</button>
                  </form>
                  {% elif booking.status == 'CONFIRMED' %}
                  <form action="{{ url('users:pandit_action_booking', booking_id=booking.booking_id) }}" method="POST" class="w-full" onsubmit="return confirm('Mark this booking as Completed?');">
                    {{ csrf_input }}<input type="hidden" name="action" value="complete">
                    <button class="btn-primary w-full justify-center py-2 text-xs">Mark Completed</button>
                  </form>
                  {% endif %}
                </div>
              </div>
            </div>
            {% else %}
            <div class="py-8 text-center text-gray-500 text-sm">No active bookings at the moment.</div>
            {% endfor %}
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        
        <div class="card p-6 border-t-4 border-t-saffron-500">
          <h3 class="font-bold text-gray-900 border-b border-gray-100 pb-3 mb-4">Profile Status</h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500">Account Status</span>
              <span class="font-semibold
               {% if request.user.panditprofile.status == 'APPROVED' %}text-green-600
               {% elif request.user.panditprofile.status == 'PENDING' %}text-yellow-600
               {% else %}text-red-600{% endif %}
               ">{{ request.user.panditprofile.status }}</span>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500">Base Price</span>
              <span class="font-semibold text-gray-900">₹{{ request.user.panditprofile.base_price }}</span>
            </div>
            <div class="flex justify-between items-center text-sm">
               <span class="text-gray-500">Base Commission</span>
               <span class="font-semibold text-gray-900">{{ request.user.panditprofile.commission_percent or '20' }}%</span>
            </div>
          </div>
          <a href="{{ url('users:profile') }}" class="btn-ghost w-full justify-center py-2.5 text-sm mt-5">Edit Profile</a>
        </div>

      </div>

    </div>
  </div>
</div>
{% endblock %}
