{% extends 'base.jinja' %}
{% block content %}
<div class="bg-gray-50 min-h-screen py-12">
  <div class="max-w-3xl mx-auto px-4">
    <div class="mb-6">
      <h1 class="font-display text-3xl font-black text-gray-900">Payout Request</h1>
      <p class="text-gray-500 mt-1">Request your earned amount from completed bookings</p>
    </div>

    <!-- Earnings Card -->
    <div class="bg-gradient-to-br from-brand-700 to-brand-900 rounded-2xl p-6 text-white mb-8">
      <p class="text-white/60 text-sm font-medium mb-1">Available for Payout</p>
      <p class="font-display text-4xl font-black">₹{{ available }}</p>
      <p class="text-white/50 text-xs mt-2">From completed bookings after 20% platform commission</p>
    </div>

    <!-- Request Form -->
    {% if available > 0 %}
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 mb-8">
      <h2 class="font-bold text-gray-900 text-lg mb-4">Request Payout</h2>
      <form method="POST">
        {{ csrf_input }}
        <div class="mb-4">
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Amount (₹)</label>
          <input type="number" name="amount" step="1" min="1" max="{{ available }}" value="{{ available }}"
                 class="input-field" placeholder="Enter amount"/>
          <p class="text-xs text-gray-400 mt-1">Max: ₹{{ available }}</p>
        </div>
        <button type="submit" class="btn-primary w-full justify-center">Request Payout →</button>
      </form>
    </div>
    {% else %}
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-5 mb-8 text-center">
      <p class="text-yellow-700 font-medium">No balance available for payout yet.</p>
      <p class="text-yellow-600 text-sm mt-1">Complete bookings to earn and then request payouts.</p>
    </div>
    {% endif %}

    <!-- Payout History -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      <div class="p-5 border-b border-gray-100">
        <h2 class="font-bold text-gray-900">Payout History</h2>
      </div>
      {% if payouts %}
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="text-left px-5 py-3 font-semibold text-gray-500 text-xs uppercase">Amount</th>
            <th class="text-left px-5 py-3 font-semibold text-gray-500 text-xs uppercase">Status</th>
            <th class="text-left px-5 py-3 font-semibold text-gray-500 text-xs uppercase">Requested</th>
            <th class="text-left px-5 py-3 font-semibold text-gray-500 text-xs uppercase">UTR</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {% for p in payouts %}
          <tr>
            <td class="px-5 py-3 font-bold text-gray-900">₹{{ p.amount }}</td>
            <td class="px-5 py-3">
              <span class="badge {% if p.status == 'PAID' %}badge-success{% elif p.status == 'APPROVED' %}badge-blue{% elif p.status == 'REJECTED' %}badge-danger{% else %}badge-warning{% endif %}">
                {{ p.status }}
              </span>
            </td>
            <td class="px-5 py-3 text-gray-500">{{ p.requested_at.strftime('%d %b %Y') }}</td>
            <td class="px-5 py-3 text-gray-400 font-mono text-xs">{{ p.utr_reference or '—' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="text-center py-12 text-gray-400">
        <p>No payouts requested yet.</p>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
