{% extends 'base.jinja' %}
{% block extra_head %}<style>@media print { .no-print { display: none; } }</style>{% endblock %}
{% block content %}
<div class="min-h-screen bg-gray-50 py-10">
  <div class="max-w-2xl mx-auto px-4">
    <div class="no-print flex justify-between items-center mb-6">
      <a href="{{ url('bookings:my_bookings') }}" class="text-sm text-gray-500 hover:text-brand-600">← My Bookings</a>
      <button onclick="window.print()" class="btn-primary py-2 px-5 text-sm">🖨️ Print / Download</button>
    </div>

    <div class="bg-white rounded-2xl shadow p-8 border border-gray-100">
      <!-- Header -->
      <div class="flex items-center justify-between mb-8">
        <div>
          <div class="text-3xl mb-1">🕉️</div>
          <h1 class="font-display text-2xl font-black text-gray-900">SD Online Pandit Jee</h1>
          <p class="text-xs text-gray-400">Online Pandit Booking Platform · Gujarat</p>
        </div>
        <div class="text-right">
          <p class="text-sm font-bold text-gray-700">INVOICE</p>
          <p class="text-xs text-gray-400 mt-1">Booking ID</p>
          <p class="font-mono text-xs text-brand-600 font-bold">{{ booking.booking_id|string|truncate(8, True, '') }}</p>
        </div>
      </div>

      <div class="border-t border-gray-100 my-6"></div>

      <!-- Client & Pandit -->
      <div class="grid grid-cols-2 gap-6 mb-8">
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold mb-2">Client</p>
          <p class="font-bold text-gray-900">{{ booking.client.get_full_name() }}</p>
          <p class="text-sm text-gray-500">{{ booking.client.email }}</p>
          <p class="text-sm text-gray-500">{{ booking.client.phone or '' }}</p>
        </div>
        <div>
          <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold mb-2">Pandit</p>
          <p class="font-bold text-gray-900">Pt. {{ booking.pandit.user.get_full_name() }}</p>
          <p class="text-sm text-gray-500">{{ booking.pandit.user.email }}</p>
          <p class="text-sm text-gray-500">{{ booking.pandit.city.name if booking.pandit.city else '' }}</p>
        </div>
      </div>

      <!-- Booking Details -->
      <div class="bg-gray-50 rounded-xl p-5 mb-6">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-gray-100">
            <tr class="py-2"><td class="py-2 text-gray-500 font-medium">Puja Type</td><td class="py-2 font-semibold text-gray-900 text-right">{{ booking.puja_category.name if booking.puja_category else 'General Puja' }}</td></tr>
            <tr class="py-2"><td class="py-2 text-gray-500 font-medium">Puja Date</td><td class="py-2 font-semibold text-gray-900 text-right">{{ booking.puja_date.strftime('%d %B %Y') }}</td></tr>
            <tr class="py-2"><td class="py-2 text-gray-500 font-medium">Puja Time</td><td class="py-2 font-semibold text-gray-900 text-right">{{ booking.puja_time.strftime('%I:%M %p') }}</td></tr>
            <tr class="py-2"><td class="py-2 text-gray-500 font-medium">Address</td><td class="py-2 font-semibold text-gray-900 text-right max-w-xs ml-auto">{{ booking.address }}</td></tr>
            <tr class="py-2"><td class="py-2 text-gray-500 font-medium">Payment Mode</td><td class="py-2 font-semibold text-gray-900 text-right">{{ booking.get_payment_mode_display() }}</td></tr>
            <tr class="py-2"><td class="py-2 text-gray-500 font-medium">Status</td><td class="py-2 text-right"><span class="badge badge-success">{{ booking.status }}</span></td></tr>
          </tbody>
        </table>
      </div>

      <!-- Amount -->
      <div class="border-t border-gray-100 pt-4">
        <div class="flex justify-between text-sm py-1"><span class="text-gray-500">Subtotal</span><span class="font-medium">₹{{ booking.amount }}</span></div>
        <div class="flex justify-between text-sm py-1"><span class="text-gray-500">Platform Fee</span><span class="font-medium">-₹{{ booking.commission_amount }}</span></div>
        <div class="flex justify-between text-base font-black py-2 border-t border-gray-100 mt-2"><span>Total Paid</span><span class="text-brand-600 text-xl">₹{{ booking.amount }}</span></div>
      </div>

      <div class="border-t border-gray-100 mt-8 pt-6 text-center text-xs text-gray-400">
        <p>Thank you for choosing SD Online Pandit Jee · For support: support@panditjee.com</p>
        <p class="mt-1">Generated on {{ booking.created_at.strftime('%d %b %Y') }}</p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
