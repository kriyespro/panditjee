<!-- templates/components/nav.jinja — Professional sticky navigation -->
<header class="sticky top-0 z-50" x-data="{ scrolled: false, profileOpen: false }"
        x-init="window.addEventListener('scroll', () => scrolled = window.scrollY > 10)">
  <div :class="scrolled ? 'bg-white/95 backdrop-blur-md shadow-sm' : 'bg-white'"
       class="border-b border-gray-100 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="{{ url('core:home') }}" class="flex items-center gap-2.5 group shrink-0">
          <div class="relative">
            <div class="w-9 h-9 bg-brand-600 rounded-xl flex items-center justify-center shadow-md group-hover:shadow-lg group-hover:scale-105 transition-all duration-200">
              <span class="text-white text-xl">🕉️</span>
            </div>
            <div class="absolute -top-0.5 -right-0.5 w-3 h-3 bg-gold-400 rounded-full border-2 border-white"></div>
          </div>
          <div class="leading-none">
            <div class="font-bold text-gray-900 text-base tracking-tight">SD Pandit<span class="text-brand-600">Jee</span></div>
            <div class="text-[10px] text-gray-400 font-medium tracking-wide uppercase mt-0.5">Online Booking</div>
          </div>
        </a>

        <!-- Desktop Links -->
        <nav class="hidden md:flex items-center gap-1">
          <a href="{{ url('core:pandit_list') }}"
             class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-brand-600 hover:bg-brand-50 rounded-lg transition-all duration-150">
            Find Pandit
          </a>
          <a href="#how-it-works"
             class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-brand-600 hover:bg-brand-50 rounded-lg transition-all duration-150">
            How It Works
          </a>
          <a href="{{ url('users:register_pandit') }}"
             class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-brand-600 hover:bg-brand-50 rounded-lg transition-all duration-150">
            Join as Pandit
          </a>
        </nav>

        <!-- Auth / User Area -->
        <div class="hidden md:flex items-center gap-3">
          {% if request.user.is_authenticated %}
          <!-- Logged-in dropdown -->
          <div class="relative" @click.outside="profileOpen = false">
            <button @click="profileOpen = !profileOpen"
                    class="flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-gray-50 transition-colors border border-transparent hover:border-gray-100">
              <div class="w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center text-white text-sm font-bold shadow-sm">
                {{ (request.user.first_name or request.user.email)[0].upper() }}
              </div>
              <div class="text-left">
                <div class="text-sm font-semibold text-gray-900 leading-none">{{ request.user.first_name or 'Account' }}</div>
                <div class="text-xs text-gray-400 mt-0.5 uppercase tracking-wide">{{ request.user.role }}</div>
              </div>
              <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" :class="{'rotate-180': profileOpen}" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>

            <div x-show="profileOpen" x-transition:enter="transition ease-out duration-150"
                 x-transition:enter-start="opacity-0 scale-95 -translate-y-1" x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                 class="absolute right-0 top-full mt-2 w-52 bg-white rounded-2xl shadow-xl border border-gray-100 py-2 origin-top-right">
              <div class="px-4 py-2 border-b border-gray-50 mb-1">
                <p class="text-xs text-gray-400">Signed in as</p>
                <p class="text-sm font-medium text-gray-800 truncate">{{ request.user.email }}</p>
              </div>
              {% if request.user.is_pandit %}
              <a href="/pandit/dashboard/" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-brand-600 transition-colors">
                <span class="w-5 text-center">📊</span> Dashboard
              </a>
              {% elif request.user.is_site_admin or request.user.is_staff %}
              <a href="/admin/" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-brand-600 transition-colors">
                <span class="w-5 text-center">⚙️</span> Admin Panel
              </a>
              {% else %}
              <a href="{{ url('users:profile') }}" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 hover:text-brand-600 transition-colors">
                <span class="w-5 text-center">👤</span> My Profile
              </a>
              {% endif %}
              <hr class="my-1 border-gray-50" />
              <a href="{{ url('users:logout') }}" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors">
                <span class="w-5 text-center">🚪</span> Logout
              </a>
            </div>
          </div>

          {% else %}
          <a href="{{ url('users:login') }}" class="btn-ghost text-sm py-2 px-4">Sign In</a>
          <a href="{{ url('users:register_client') }}" class="btn-primary text-sm py-2.5 px-5">Book a Pandit →</a>
          {% endif %}
        </div>

        <!-- Mobile hamburger -->
        <button @click="mobileMenu = !mobileMenu"
                class="md:hidden p-2 rounded-xl hover:bg-gray-100 transition-colors text-gray-700">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path x-show="!mobileMenu" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            <path x-show="mobileMenu" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div x-show="mobileMenu" x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0"
         class="md:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-5 space-y-1">
      <a href="{{ url('core:pandit_list') }}" class="block px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-brand-600 rounded-xl transition-colors">Find Pandit</a>
      <a href="{{ url('users:register_pandit') }}" class="block px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-brand-600 rounded-xl transition-colors">Join as Pandit</a>
      <div class="pt-2 flex flex-col gap-2">
        {% if request.user.is_authenticated %}
        <a href="{{ url('users:logout') }}" class="btn-ghost w-full justify-center text-red-600 border-red-100 hover:bg-red-50">Logout</a>
        {% else %}
        <a href="{{ url('users:login') }}" class="btn-ghost w-full justify-center">Sign In</a>
        <a href="{{ url('users:register_client') }}" class="btn-primary w-full justify-center">Book a Pandit →</a>
        {% endif %}
      </div>
    </div>
  </div>
</header>
