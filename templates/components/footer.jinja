<!-- templates/components/footer.jinja — Premium footer -->
<footer class="bg-gray-950 text-gray-400">
  <!-- Top section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-brand-600 rounded-xl flex items-center justify-center text-2xl shadow">🕉️</div>
          <div>
            <div class="font-bold text-white text-lg leading-none">SD PanditJee</div>
            <div class="text-xs text-gray-500 mt-0.5">Online Booking Platform</div>
          </div>
        </div>
        <p class="text-sm leading-relaxed max-w-xs mb-6">
          India's trusted platform for booking verified and experienced pandits for all your sacred ceremonies — anywhere in Gujarat.
        </p>
        <div class="flex gap-2">
          {% for (icon, label) in [('📘','Facebook'),('📸','Instagram'),('🐦','Twitter'),('📺','YouTube')] %}
          <a href="#" aria-label="{{ label }}"
             class="w-9 h-9 rounded-xl bg-gray-800 hover:bg-brand-600 flex items-center justify-center text-sm transition-all duration-200 hover:scale-105">
            {{ icon }}
          </a>
          {% endfor %}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">Platform</h4>
        <ul class="space-y-3 text-sm">
          {% for (label, href) in [('Find Pandit', url('core:pandit_list')), ('Register as Client', url('users:register_client')), ('Join as Pandit', url('users:register_pandit')), ('Login', url('users:login'))] %}
          <li>
            <a href="{{ href }}" class="hover:text-white transition-colors flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full bg-brand-500 shrink-0"></span>{{ label }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>

      <!-- Cities -->
      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">Cities</h4>
        <ul class="space-y-3 text-sm">
          {% for (city, slug) in [('Surat','surat'),('Ahmedabad','ahmedabad'),('Vadodara','vadodara')] %}
          <li>
            <a href="{{ url('core:pandit_list') }}?city={{ slug }}"
               class="hover:text-white transition-colors flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full bg-brand-500 shrink-0"></span>📍 {{ city }}
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-gray-800"></div>

  <!-- Bottom bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-600">
      <p>© 2024 SD PanditJee. All rights reserved.</p>
      <div class="flex gap-5">
        {% for label in ['Privacy Policy', 'Terms of Service', 'Contact Us', 'Refund Policy'] %}
        <a href="#" class="hover:text-white transition-colors">{{ label }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</footer>
