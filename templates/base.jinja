<!DOCTYPE html>
<html lang="en" x-data="{ mobileMenu: false }">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ page_title | default('SD Online Pandit Jee — Book Verified Pandits') }}</title>
  <meta name="description" content="{{ meta_description | default('Book verified pandits online in Gujarat — Surat, Ahmedabad, Vadodara for all puja ceremonies.') }}" />
  <meta name="theme-color" content="#b91c1c" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#fff1f1', 100: '#ffe1e1', 200: '#ffc7c7',
              300: '#ffa0a0', 400: '#ff6b6b', 500: '#f83b3b',
              600: '#c81c1c', 700: '#a51515', 800: '#881111',
              900: '#6f0f0f', 950: '#3d0505',
            },
            saffron: { 400: '#fb923c', 500: '#f97316', 600: '#ea580c' },
            gold:    { 300: '#fde047', 400: '#facc15', 500: '#eab308' },
          },
          fontFamily: {
            sans:    ['Inter', 'sans-serif'],
            display: ['Playfair Display', 'serif'],
          },
          boxShadow: {
            'glass': '0 8px 32px rgba(0,0,0,0.12)',
            'card':  '0 2px 8px rgba(0,0,0,0.07), 0 0 0 1px rgba(0,0,0,0.04)',
            'card-hover': '0 8px 24px rgba(0,0,0,0.12), 0 0 0 1px rgba(200,28,28,0.15)',
          },
          animation: {
            'fade-up':   'fadeUp 0.4s ease-out',
            'slide-in':  'slideIn 0.3s ease-out',
            'pulse-slow':'pulse 3s ease-in-out infinite',
          },
          keyframes: {
            fadeUp:  { '0%': { opacity:'0', transform:'translateY(20px)' }, '100%': { opacity:'1', transform:'translateY(0)' }},
            slideIn: { '0%': { opacity:'0', transform:'translateX(-10px)' }, '100%': { opacity:'1', transform:'translateX(0)' }},
          },
          backdropBlur: { xs: '2px' },
        }
      }
    }
  </script>

  <!-- Alpine.js -->
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <!-- HTMX -->
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; background: #f8f8f8; color: #1a1a1a; -webkit-font-smoothing: antialiased; }

    /* ── Utilities ─────────────────────────────── */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: #c81c1c; color: #fff; font-weight: 600;
      padding: 0.75rem 1.5rem; border-radius: 0.75rem;
      transition: all 0.2s; box-shadow: 0 4px 12px rgba(200,28,28,0.35);
      border: none; cursor: pointer; font-size: 0.9rem; letter-spacing: 0.01em;
    }
    .btn-primary:hover { background: #a51515; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(200,28,28,0.4); }
    .btn-primary:active { transform: translateY(0); }

    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: #fff; color: #c81c1c; font-weight: 600;
      padding: 0.75rem 1.5rem; border-radius: 0.75rem;
      border: 2px solid #c81c1c; transition: all 0.2s;
      cursor: pointer; font-size: 0.9rem;
    }
    .btn-secondary:hover { background: #fff1f1; transform: translateY(-1px); }

    .btn-ghost {
      display: inline-flex; align-items: center; gap: 0.5rem;
      color: #4b5563; font-weight: 500; padding: 0.6rem 1.2rem;
      border-radius: 0.75rem; border: 1px solid #e5e7eb;
      background: #fff; transition: all 0.2s; cursor: pointer; font-size: 0.875rem;
    }
    .btn-ghost:hover { border-color: #c81c1c; color: #c81c1c; background: #fff1f1; }

    .card {
      background: #fff; border-radius: 1rem; border: 1px solid #f0f0f0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      transition: box-shadow 0.25s, transform 0.25s;
    }
    .card:hover { box-shadow: 0 8px 28px rgba(0,0,0,0.10), 0 0 0 1px rgba(200,28,28,0.12); transform: translateY(-2px); }

    .section-tag {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
      color: #c81c1c; background: #fff1f1; padding: 0.3rem 0.9rem; border-radius: 99px;
      margin-bottom: 1rem; border: 1px solid #ffc7c7;
    }
    .section-title { font-family: 'Playfair Display', serif; font-size: 2.25rem; font-weight: 700; color: #111; line-height: 1.2; }
    .section-sub   { color: #6b7280; font-size: 1rem; margin-top: 0.5rem; line-height: 1.6; }

    .input-field {
      width: 100%; padding: 0.8rem 1rem; font-size: 0.9rem; color: #111;
      border: 1.5px solid #e5e7eb; border-radius: 0.75rem; background: #fafafa;
      transition: border-color 0.2s, box-shadow 0.2s; outline: none; font-family: 'Inter', sans-serif;
    }
    .input-field:focus { border-color: #c81c1c; box-shadow: 0 0 0 3px rgba(200,28,28,0.12); background: #fff; }

    .badge         { display: inline-flex; align-items: center; padding: 0.2rem 0.7rem; border-radius: 99px; font-size: 0.75rem; font-weight: 600; }
    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-danger  { background: #fee2e2; color: #991b1b; }
    .badge-blue    { background: #dbeafe; color: #1e40af; }

    .divider { height: 1px; background: linear-gradient(90deg, transparent, #e5e7eb, transparent); margin: 0; }

    /* ── Scrollbar ─────────────────────────────── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f1f1; }
    ::-webkit-scrollbar-thumb { background: #c81c1c; border-radius: 3px; }

    /* ── Star Rating ───────────────────────────── */
    .stars { color: #f59e0b; letter-spacing: -2px; }

    /* ── Flash Toast ───────────────────────────── */
    .toast-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
    .toast-error   { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; }
    .toast-warning { background: #fffbeb; border: 1px solid #fde68a; color: #d97706; }
    .toast-info    { background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; }
  </style>

  {% block extra_head %}{% endblock %}
</head>

<body class="flex flex-col min-h-screen">

  {% include 'components/nav.jinja' %}

  <!-- Flash Messages -->
  {% set msgs = get_messages(request) %}
  {% if msgs %}
  <div class="fixed top-20 right-4 z-[200] flex flex-col gap-2 w-80" id="toast-container">
    {% for message in msgs %}
    <div x-data="{ show: true }" x-show="show" x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-x-8" x-transition:enter-end="opacity-100 translate-x-0"
         x-transition:leave="transition ease-in duration-200" x-transition:leave-end="opacity-0 translate-x-8"
         class="flex items-start gap-3 p-4 rounded-xl shadow-lg
         {% if message.tags == 'success' %}toast-success
         {% elif message.tags == 'error' %}toast-error
         {% elif message.tags == 'warning' %}toast-warning
         {% else %}toast-info{% endif %}"
         x-init="setTimeout(()=>show=false, 4500)">
      <span class="text-lg shrink-0">
        {% if message.tags == 'success' %}✅{% elif message.tags == 'error' %}❌{% elif message.tags == 'warning' %}⚠️{% else %}ℹ️{% endif %}
      </span>
      <p class="flex-1 text-sm font-medium leading-snug">{{ message }}</p>
      <button @click="show=false" class="opacity-50 hover:opacity-100 text-lg leading-none mt-0.5">×</button>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <main class="flex-grow">
    {% block content %}{% endblock %}
  </main>

  {% include 'components/footer.jinja' %}

  {% block extra_js %}{% endblock %}
</body>
</html>
